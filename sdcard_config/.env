# Dashcam Network Settings (Assign a Static DHCP lease in your router!)
DASHCAM_IP=192.168.1.150
DASHCAM_FTP_USER=root
DASHCAM_FTP_PASS=

# Remote SD Card Path (Default on 70mai A800S/A810S is /mnt/sdcard/DCIM or /tmp/SD0/DCIM)
REMOTE_PATH=/mnt/sdcard/DCIM

# Local Server Settings
LOCAL_BACKUP_DIR=/backups
POLL_INTERVAL_SECONDS=30
COOLDOWN_AFTER_SYNC_SECONDS=1800
RETENTION_DAYS=30

# Optional: Webhook URL for backup completion alerts (e.g., ntfy.sh, Discord, Home Assistant)
WEBHOOK_URL=
